# ====================================
# ATMDS Bot Configuration
# Copy file ini ke .env dan isi nilainya
# ====================================

# Discord Bot Token (dari https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Cerebras API Key (dari https://inference.cerebras.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Cerebras Model (qwen-3-32b recommended, hemat & cepat)
CEREBRAS_MODEL=qwen-3-32b

# Nama User (yang akan dipanggil oleh asisten)
USER_NAME=Tuan

# Nama Asisten
ASSISTANT_NAME=Aya

# Discord User ID kamu (klik kanan profil -> Copy User ID)
# Bot hanya akan merespon ke user ini (privasi)
DISCORD_USER_ID=0

# Jadwal notif makan (format 24 jam, dipisah koma)
MEAL_TIMES=12:00,18:00,21:00

# Rest mode: setelah X menit tanpa chat, bot masuk mode hemat token
REST_MODE_TIMEOUT=30

# Pakai LLM untuk reminder makan? (true=personal, false=hemat token)
USE_LLM_FOR_REMINDERS=false

# ========== CAMPUS CHECKER (OPSIONAL) ==========
# Aktifkan pengecekan tugas kampus otomatis
CAMPUS_CHECK_ENABLED=false

# Jam pengecekan harian (format 24 jam)
CAMPUS_CHECK_TIME=08:00

# URL halaman daftar tugas kampus kamu (bisa di-set via Discord: !kampus set <url>)
CAMPUS_URL=

# Cookies untuk akses halaman yang butuh login (bisa di-set via Discord: !kampus cookie <cookie>)
# Format: name1=value1; name2=value2
CAMPUS_COOKIES=
